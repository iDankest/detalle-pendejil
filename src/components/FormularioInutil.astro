<section class="max-w-2xl mx-auto py-20 px-6 text-center">
  <h2 class="text-2xl font-bold text-blue-400 mb-6 italic">¿Qué te ha parecido el despliegue?</h2>
  
  <div id="form-container" class="space-y-4">
    <textarea id="feedback-text" class="w-full p-4 rounded-xl bg-gray-800 border border-gray-700 text-white focus:border-pink-500 outline-none transition-all" placeholder="Escribe aquí tus quejas legales..."></textarea>
    <button id="send-feedback" class="w-full py-3 bg-pink-600 rounded-full font-bold hover:bg-pink-500 transition-colors shadow-lg">ENVIAR AL CORAZÓN</button>
  </div>

  <div id="feedback-response" class="hidden mt-6 p-4 bg-green-900/30 border border-green-500 rounded-xl text-green-400 font-mono">
    "¡Mensaje enviado con éxito! Tu feedback ha llegado a mi corazón (y se ha quedado ahí porque no he programado la base de datos). Gracias pendejita."
  </div>

<div id="bonus-video" class="hidden mt-12 opacity-0">
  <h3 class="text-yellow-400 font-black text-2xl mb-6 uppercase">✨ RECOMPENSA POR SER PESADA ✨</h3>
  
  <div class="relative max-w-[280px] md:max-w-[320px] mx-auto rounded-3xl overflow-hidden border-4 border-yellow-500 shadow-[0_0_20px_rgba(234,179,8,0.3)]">
    <video 
      id="video-bonus"
      controls 
      muted 
      preload="none" 
      class="w-full aspect-[9/16] object-cover bg-black">
      <source src="/bolitos.mp4" type="video/mp4">
    </video>
  </div>
</div>
  
</section>


<script>
  import { gsap } from "gsap";
  const btn = document.querySelector('#send-feedback');
  const container = document.querySelector('#form-container');
  const response = document.querySelector('#feedback-response');
  const bonus = document.querySelector('#bonus-video');

  btn?.addEventListener('click', () => {
    // 1. Animación de salida del form (Tu lógica original mejorada)
    gsap.to(container, {
      duration: 0.8,
      y: -30,
      opacity: 0,
      onComplete: () => {
        container?.classList.add('hidden');
        response?.classList.remove('hidden');
        
        // 2. Animación de entrada de tu mensaje
        gsap.fromTo(response, 
          { scale: 0.8, opacity: 0 }, 
          { scale: 1, opacity: 1, duration: 0.5, ease: "back.out(1.7)" }
        );

        // 3. El Bonus Track aparece un poco después del mensaje
        setTimeout(() => {
          bonus?.classList.remove('hidden');
          gsap.to(bonus, {
            opacity: 1,
            y: -10,
            duration: 1,
            delay: 0.5,
            ease: "power2.out"
          });
        }, 1000);
      }
    });
  });
  const video = document.querySelector('#video-bonus') as HTMLVideoElement;
  if (video) {
    video.volume = 0.3; // Volumen al 30% por defecto cuando lo active
  }
</script>