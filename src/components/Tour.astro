<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // 1. Animación de entrada al hacer Scroll
  const blocks = document.querySelectorAll('.tour-block');
  blocks.forEach((block) => {
    gsap.from(block, {
      scrollTrigger: {
        trigger: block,
        start: "top 85%",
        toggleActions: "play none none reverse"
      },
      y: 50,
      opacity: 0,
      duration: 1,
      ease: "power2.out"
    });
  });

  // 2. Efecto Parallax en el Hover
  const containers = document.querySelectorAll('.image-container');
  containers.forEach(container => {
    const hoverImg = container.querySelector('.hover-image');
    
    container.addEventListener('mousemove', (e: MouseEvent) => {
      const { left, top, width, height } = container.getBoundingClientRect();
      const xPos = (e.clientX - left) / width - 0.5;
      const yPos = (e.clientY - top) / height - 0.5;

      gsap.to(hoverImg, {
        x: xPos * 30, // Intensidad del movimiento
        y: yPos * 30,
        duration: 0.6,
        ease: "power2.out"
      });
    });

    container.addEventListener('mouseleave', () => {
      gsap.to(hoverImg, { x: 0, y: 0, duration: 0.6 });
    });
  });
</script>

