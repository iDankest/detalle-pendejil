import Inicio from '../components/inicio.astro';
import Tour from '../components/Tour.astro';
import TrollUX from '../components/TrollUX.astro';
import FormularioInutil from '../components/FormularioInutil.astro';
import Footerloco from '../components/Footerloco.astro';
---

<Layout>
	<TrollUX />
	<Inicio />
	<Bento />
  <Tour />
